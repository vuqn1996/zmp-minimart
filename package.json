{
  "name": "zmp-minimart",
  "version": "1.0.0",
  "description": "Zalo Mini App template for minimarts and grocery stores: multi-branch catalog, cart, checkout and order tracking.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "zmp": {
    "customProject": true,
    "outputDir": "www"
  },
  "scripts": {
    "start": "zmp start",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && zmp sync-config www/index.html && zmp deploy --outputDir www",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "react-swipeable": "^7.0.2",
    "zmp-sdk": "^2.53.0",
    "zmp-sdk-modern": "npm:zmp-sdk@2.53.0",
    "zmp-ui": "1.11.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^20.11.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "zmp-cli": "4.0.3",
    "zmp-vite-plugin": "^1.1.6"
  },
  "overrides": {
    "zmp-sdk@2.9.4": {
      "axios": "0.33.0"
    },
    "qs": "^6.16.0",
    "zmp-ui": {
      "react-router-dom": "^6.30.6"
    }
  }
}
